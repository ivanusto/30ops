# generated by 30ops X.Y.Z from site.yaml sha256:919434bd9368be3c4c7a295072654da933f684cdaf09b57658282ccf642dc7d5; do not edit
# /etc/pcap/corosync.env: PVE node only. corosync knet between the two nodes
# (UDP 5405 by default, up to 5412 with more links) and the QDevice vote to
# qnetd on the NAS VM (TCP 5403, Day 15). knet encrypts the payload, so 128
# bytes of header is everything there is to read. Ring mode: twenty files
# of 50 MB, the oldest overwritten, stop it by hand when the token loss has
# happened again: `systemctl stop pcap@corosync`.
IFACE=vmbr0
FILTER="udp portrange 5405-5412 or tcp port 5403"
SNAPLEN=128
MODE=ring
SIZE_MB=50
KEEP_FILES=20
