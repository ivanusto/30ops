# /etc/default/gb10-host-guard
# Thresholds for gb10-host-guard.service. Every value here came from
# measurement on one machine (see gb10-ops README); recalibrate against your
# own idle and steady state before trusting them.
INTERVAL=10
WARN_GIB=6.0
ACT_GIB=3.0
SUSTAIN=3
NVRM_RATE=5
# Process names matching this regex are never terminated.
PROTECT=VLLM::
# Leave --dry-run on for the first day; the guard logs would_kill instead of acting.
DRY_RUN=--dry-run
